# Optional Firebase Web configuration for cross-device encrypted sync.
# Leave unset to run locally via localStorage and BroadcastChannel.
# Client config values identify the Firebase project; confidentiality is enforced
# by client-side AES-256-GCM encryption, firestore.rules, and HTTP referrer restrictions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
