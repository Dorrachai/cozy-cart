# Optional Firebase Spark Free Tier ($0) configuration for cross-device sync.
# Leave blank to run in instant Local / Same-Browser-Tabs mode.
# In Firebase Web apps, these identifiers are public by design — privacy is
# guaranteed by client-side AES-256-GCM encryption + firestore.rules + HTTP Referrer restrictions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
